local BY_OWNER: { [string]: { UnlockConfig } } = {}
for index, entry in LIST do
	local frozen = table.freeze(entry)
	LIST[index] = frozen

	local bucket = BY_OWNER[frozen.owner]
	if bucket == nil then
		bucket = {}
		BY_OWNER[frozen.owner] = bucket
	end
	table.insert(bucket, frozen)
end

for owner, bucket in BY_OWNER do
	BY_OWNER[owner] = table.freeze(bucket)
end

--[[ The ladder gated on every business rather than one. ]]
local CAPITALIST = "Capitalist"

return table.freeze({
	list = table.freeze(LIST),
	byOwner = table.freeze(BY_OWNER),
	capitalist = CAPITALIST,
})
