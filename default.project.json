{
  "name": "Tycoon Capitalist",
  "globIgnorePaths": ["**/.package-lock.json"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": { "optional": "Packages" }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "ServerPackages": {
        "$path": { "optional": "ServerPackages" }
      }
    },

    "ServerStorage": {
      "Tests": {
        "$path": "tests"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts"
      }
    },

    "StarterGui": {
      "$properties": {
        "ScreenOrientation": "Sensor",
        "ResetPlayerGuiOnSpawn": false
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
